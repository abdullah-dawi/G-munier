---
import type { CollectionEntry } from 'astro:content';

interface Props {
  series: CollectionEntry<'series'>;
  count: number;
}
const { series, count } = Astro.props;
const { title, description, category, status, placeholder } = series.data;
---
<a
  href={`/series/${series.id}/`}
  class="block rounded-xl border border-line bg-white/60 p-5 transition hover:border-accent hover:shadow-sm"
>
  <div class="flex items-center justify-between gap-2 text-xs text-muted">
    <span>{category}</span>
    {placeholder ? <span class="placeholder-badge">نموذج</span> : <span>{status}</span>}
  </div>
  <h3 class="mt-2 font-serif text-xl text-ink">{title}</h3>
  <p class="mt-1 text-sm text-muted">{description}</p>
  <p class="mt-3 text-sm text-accent">{count} درس</p>
</a>
