---
// تضمين خفيف: صورة مصغرة فقط، والـ iframe يتحمل عند الضغط
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---
<yt-lite data-id={id} class="relative block aspect-video overflow-hidden rounded-xl bg-black">
  <button
    type="button"
    class="group absolute inset-0 w-full"
    aria-label={`تشغيل: ${title}`}
  >
    <img
      src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
      alt=""
      loading="lazy"
      class="h-full w-full object-cover opacity-90 group-hover:opacity-100"
    />
    <span class="absolute inset-0 m-auto grid h-16 w-16 place-items-center rounded-full bg-accent/90 text-2xl text-white">▶</span>
  </button>
</yt-lite>

<script>
  class YtLite extends HTMLElement {
    connectedCallback() {
      this.querySelector('button')?.addEventListener('click', () => {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${this.dataset.id}?autoplay=1`;
        iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.className = 'absolute inset-0 h-full w-full';
        this.replaceChildren(iframe);
      }, { once: true });
    }
  }
  customElements.define('yt-lite', YtLite);
</script>
