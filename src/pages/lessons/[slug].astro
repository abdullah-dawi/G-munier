---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import YouTube from '../../components/YouTube.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import Share from '../../components/Share.astro';
import { SITE } from '../../site.config';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((l) => ({ params: { slug: l.id }, props: { lesson: l } }));
}

const { lesson } = Astro.props;
const series = await getEntry(lesson.data.series);
const siblings = (await getCollection('lessons', (l) => l.data.series.id === lesson.data.series.id)).sort(
  (a, b) => a.data.order - b.data.order
);
const i = siblings.findIndex((l) => l.id === lesson.id);
const prev = i > 0 ? siblings.at(i - 1) : undefined;
const next = siblings.at(i + 1);
const { Content } = await render(lesson);
const { title, youtube_id, audio_url, date, placeholder, summary } = lesson.data;
const isKhutba = series.data.kind === 'خطب';
const unit = isKhutba ? 'الخطبة' : 'الدرس';
const transcript = (lesson.body ?? '').trim();
const hasTranscript = transcript.length > 0;
const words = hasTranscript ? transcript.split(/\s+/).length : 0;
const minutes = Math.max(1, Math.round(words / 180));
// نص التفريغ للنسخ: بدون رموز Markdown
const plain = transcript.replace(/^#{1,6}\s*/gm, '').replace(/^>\s?/gm, '').replace(/\*\*/g, '');
const copyText = `${title}\n${series.data.title} — ${SITE.sheikhName}\n\n${plain}`;
---
<Base title={title} description={summary}>
  <p class="text-sm text-muted">
    <a href={`/series/${series.id}/`} class="hover:text-accent">{series.data.title}</a>
    · {unit} {lesson.data.order}
  </p>
  <h1 class="mt-2 font-serif text-3xl text-accent">{title}</h1>
  <p class="mt-1 text-sm text-muted">
    {date.toLocaleDateString('ar-EG', { dateStyle: 'long' })}
    {placeholder && <span class="placeholder-badge ms-2">نموذج</span>}
  </p>

  <div class="no-print mt-6 space-y-4">
    {youtube_id && <YouTube id={youtube_id} title={title} />}
    {audio_url && <AudioPlayer src={audio_url} storageKey={lesson.id} />}
    {!youtube_id && !audio_url && (
      <div class="grid aspect-video place-items-center rounded-xl border-2 border-dashed border-line text-muted">
        مكان الفيديو أو الصوت
      </div>
    )}
  </div>

  <div class="no-print mt-4"><Share text={`${title} — ${series.data.title}`} /></div>

  {summary && (
    <section class="mt-8 rounded-xl border border-accent/30 bg-accent/5 p-5">
      <h2 class="text-sm font-semibold text-accent">ملخص {unit}</h2>
      <p class="mt-2 leading-loose">{summary}</p>
    </section>
  )}

  <section class="mt-10">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line pb-3">
      <h2 class="font-serif text-2xl text-accent">
        التفريغ
        {hasTranscript && <span class="ms-2 font-sans text-sm text-muted">قراءة في {minutes} دقيقة تقريبًا</span>}
      </h2>
      {hasTranscript && (
        <div class="no-print flex gap-2 text-sm">
          <button type="button" id="copy-transcript" data-copy={copyText} class="rounded-full bg-accent px-4 py-1 text-white hover:opacity-90">نسخ التفريغ</button>
          <button type="button" onclick="window.print()" class="rounded-full border border-line px-4 py-1 hover:border-accent hover:text-accent">طباعة / PDF</button>
        </div>
      )}
    </div>
    {hasTranscript ? (
      <article class="transcript mt-6">
        <Content />
      </article>
    ) : (
      <p class="mt-6 rounded-xl border-2 border-dashed border-line p-6 text-center text-muted">لم يُفرَّغ {unit === 'الخطبة' ? 'هذه الخطبة' : 'هذا الدرس'} بعد.</p>
    )}
  </section>

  <nav class="no-print mt-12 flex justify-between gap-4 border-t border-line pt-6 text-sm">
    {prev ? <a href={`/lessons/${prev.id}/`} class="text-accent">→ {prev.data.title}</a> : <span />}
    {next ? <a href={`/lessons/${next.id}/`} class="text-accent">{next.data.title} ←</a> : <span />}
  </nav>
</Base>

<script>
  const btn = document.getElementById('copy-transcript');
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.copy ?? '');
      btn.textContent = 'تم النسخ ✓';
      setTimeout(() => (btn.textContent = 'نسخ التفريغ'), 1500);
    } catch {}
  });
</script>
