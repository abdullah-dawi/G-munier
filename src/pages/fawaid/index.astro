---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FaidaCard from '../../components/FaidaCard.astro';

const fawaid = (await getCollection('fawaid')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="الفوائد" description="فوائد قصيرة من دروس وخطب فضيلة الشيخ جهاد منير.">
  <h1 class="font-serif text-3xl text-accent">الفوائد</h1>
  <p class="mt-2 text-muted">كلمات قصيرة من الدروس والخطب، شاركها بضغطة.</p>
  <div class="mt-6 space-y-4">
    {fawaid.map((f) => <FaidaCard faida={f} />)}
  </div>
</Base>
