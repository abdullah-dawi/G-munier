---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Share from '../../components/Share.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((a) => ({ params: { slug: a.id }, props: { article: a } }));
}
const { article } = Astro.props;
const { Content } = await render(article);
const { title, summary, category, date, placeholder } = article.data;
---
<Base title={title} description={summary}>
  <p class="text-sm text-muted"><a href="/articles/" class="hover:text-accent">المقالات</a> / {category}</p>
  <h1 class="mt-2 font-serif text-3xl text-accent">{title}</h1>
  <p class="mt-1 text-sm text-muted">
    {date.toLocaleDateString('ar-EG', { dateStyle: 'long' })}
    {placeholder && <span class="placeholder-badge ms-2">نموذج</span>}
  </p>
  <article class="mt-8 space-y-4 text-lg leading-loose">
    <Content />
  </article>
  <div class="mt-8 border-t border-line pt-6"><Share text={`${title} — الشيخ جهاد منير`} /></div>
</Base>
