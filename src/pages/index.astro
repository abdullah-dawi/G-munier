---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SeriesCard from '../components/SeriesCard.astro';
import FaidaCard from '../components/FaidaCard.astro';
import { SITE } from '../site.config';

const series = await getCollection('series');
const lessons = await getCollection('lessons');
const countFor = (id: string) => lessons.filter((l) => l.data.series.id === id).length;
const khutab = series.filter((s) => s.data.kind === 'خطب').slice(0, 4);
const courses = series.filter((s) => s.data.kind === 'دورة').slice(0, 4);
const byDate = <T extends { data: { date: Date } }>(a: T, b: T) => b.data.date.valueOf() - a.data.date.valueOf();
const latest = [...lessons].sort(byDate).slice(0, 5);
const faida = (await getCollection('fawaid')).sort(byDate).at(0);
const articles = (await getCollection('articles')).sort(byDate).slice(0, 3);
---
<Base>
  <section class="py-6 text-center">
    <h1 class="font-serif text-4xl text-accent">{SITE.sheikhName}</h1>
    <p class="mt-3 text-muted">{SITE.tagline}</p>
  </section>

  {faida && (
    <section class="mt-4">
      <h2 class="mb-3 text-sm font-semibold text-muted">فائدة</h2>
      <FaidaCard faida={faida} />
    </section>
  )}

  <section class="mt-10">
    <div class="flex items-baseline justify-between">
      <h2 class="font-serif text-2xl">سلاسل الخطب</h2>
      <a href="/khutab/" class="text-sm text-accent">كل الخطب</a>
    </div>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {khutab.map((s) => <SeriesCard series={s} count={countFor(s.id)} />)}
    </div>
  </section>

  <section class="mt-10">
    <div class="flex items-baseline justify-between">
      <h2 class="font-serif text-2xl">الدورات العلمية</h2>
      <a href="/courses/" class="text-sm text-accent">كل الدورات</a>
    </div>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {courses.map((s) => <SeriesCard series={s} count={countFor(s.id)} />)}
    </div>
  </section>

  <section class="mt-10 grid gap-8 sm:grid-cols-2">
    <div>
      <h2 class="font-serif text-2xl">الأحدث</h2>
      <ul class="mt-4 divide-y divide-line rounded-xl border border-line bg-white/60">
        {latest.map((l) => (
          <li>
            <a href={`/lessons/${l.id}/`} class="flex justify-between gap-4 px-4 py-3 hover:text-accent">
              <span>{l.data.title}</span>
              <time class="shrink-0 text-sm text-muted" datetime={l.data.date.toISOString()}>
                {l.data.date.toLocaleDateString('ar-EG')}
              </time>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <div class="flex items-baseline justify-between">
        <h2 class="font-serif text-2xl">مقالات</h2>
        <a href="/articles/" class="text-sm text-accent">الكل</a>
      </div>
      <ul class="mt-4 space-y-3">
        {articles.map((a) => (
          <li>
            <a href={`/articles/${a.id}/`} class="block rounded-xl border border-line bg-white/60 px-4 py-3 hover:border-accent">
              <span class="block">{a.data.title}</span>
              <span class="text-sm text-muted">{a.data.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
