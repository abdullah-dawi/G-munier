---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Share from '../../components/Share.astro';

export async function getStaticPaths() {
  const series = await getCollection('series');
  const lessons = await getCollection('lessons');
  return series.map((s) => ({
    params: { slug: s.id },
    props: {
      series: s,
      lessons: lessons.filter((l) => l.data.series.id === s.id).sort((a, b) => a.data.order - b.data.order),
    },
  }));
}

const { series, lessons } = Astro.props;
const { title, description, category, book, status, placeholder, kind } = series.data;
const isKhutab = kind === 'خطب';
const parent = isKhutab ? { href: '/khutab/', label: 'الخطب' } : { href: '/courses/', label: 'الدورات' };
const unit = isKhutab ? 'خطبة' : 'درس';
---
<Base title={title} description={description}>
  <p class="text-sm text-muted">
    <a href={parent.href} class="hover:text-accent">{parent.label}</a> / {category}
  </p>
  <h1 class="mt-2 font-serif text-3xl text-accent">{title}</h1>
  <p class="mt-2 text-muted">{description}</p>
  <div class="mt-3 flex flex-wrap gap-3 text-sm">
    {book && <span>الكتاب: {book}</span>}
    <span>{status}</span>
    <span>{lessons.length} {unit}</span>
    {placeholder && <span class="placeholder-badge">محتوى نموذجي</span>}
  </div>
  <div class="mt-4"><Share text={`${title} — الشيخ جهاد منير`} /></div>

  <ol class="mt-8 divide-y divide-line rounded-xl border border-line bg-white/60">
    {lessons.map((l) => (
      <li>
        <a href={`/lessons/${l.id}/`} class="flex items-center gap-4 px-4 py-3 hover:text-accent">
          <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-accent/10 text-sm text-accent">
            {l.data.order}
          </span>
          <span class="flex-1">
            {l.data.title}
            {(l.body ?? '').trim() && <span class="ms-2 rounded-full bg-accent/10 px-2 text-xs text-accent">مفرّغة</span>}
          </span>
          <time class="shrink-0 text-xs text-muted" datetime={l.data.date.toISOString()}>
            {l.data.date.toLocaleDateString('ar-EG')}
          </time>
        </a>
      </li>
    ))}
  </ol>
</Base>
