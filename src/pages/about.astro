---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import { SITE } from '../site.config';

// السيرة الذاتية — كل قسم يُملأ من النبذة المعتمدة من الشيخ
const sections = [
  { title: 'نبذة', body: '[نبذة مختصرة في سطرين أو ثلاثة عن الشيخ ومجال اهتمامه]' },
  { title: 'الطلب والتعليم', items: ['[المؤهل الدراسي]', '[الدراسة الشرعية والمعاهد]'] },
  { title: 'الشيوخ والإجازات', items: ['[شيخ ١ — ما قرأه عليه]', '[شيخ ٢ — الإجازة]'] },
  { title: 'الإنتاج العلمي', items: ['[عدد الدورات والسلاسل المقدمة]', '[المؤلفات أو البحوث إن وجدت]'] },
  { title: 'الإمامة والخطابة', items: ['[المسجد / الجهة]', '[المهام الدعوية الحالية]'] },
];
---
<Base title="السيرة الذاتية">
  <div class="flex flex-col items-center gap-4 text-center sm:flex-row sm:text-start">
    <div class="grid h-28 w-28 shrink-0 place-items-center rounded-full border-2 border-dashed border-line text-xs text-muted">
      صورة الشيخ
    </div>
    <div>
      <h1 class="font-serif text-3xl text-accent">{SITE.sheikhName}</h1>
      <p class="mt-1 text-muted">{SITE.tagline}</p>
      <span class="placeholder-badge mt-2">في انتظار السيرة المعتمدة من الشيخ</span>
    </div>
  </div>

  <div class="mt-10 space-y-8">
    {sections.map((s) => (
      <section>
        <h2 class="border-b border-line pb-2 font-serif text-xl text-accent">{s.title}</h2>
        {s.body && <p class="mt-3 text-muted">{s.body}</p>}
        {s.items && (
          <ul class="mt-3 list-disc space-y-1 ps-6 text-muted">
            {s.items.map((i) => <li>{i}</li>)}
          </ul>
        )}
      </section>
    ))}
    <section>
      <h2 class="border-b border-line pb-2 font-serif text-xl text-accent">التواصل</h2>
      <div class="mt-3"><Contact /></div>
    </section>
  </div>
</Base>
